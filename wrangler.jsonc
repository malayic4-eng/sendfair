// Cloudflare Workers settings for SendFair. Cloudflare reads this on every deploy.
{
  "name": "sendfair",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // Satori/resvg pull in a little Node surface (Buffer) and WASM modules.
  "compatibility_flags": ["nodejs_compat"],
  // Builds the site into dist/ before each deploy.
  "build": { "command": "node scripts/build.mjs" },
  // Satori's layout engine and resvg's renderer are compiled to WASM, and the card fonts are
  // imported as bytes. Cloudflare bundles these into the Worker.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker for admin, API, redirect, logo, result-image, saved house-plan and embed-widget routes (the www redirect is a Cloudflare rule).
    "run_worker_first": ["/admin*", "/api/*", "/go/*", "/logos/*", "/og/*", "/cost-to-build/*/plan/*", "/embed/widget*", "/quote-check/report/*", "/quote-check/pay/*"]
  },
  // The site's own address. www is forwarded to the main address.
  "routes": [
    { "pattern": "sendfair.africa", "custom_domain": true },
    { "pattern": "www.sendfair.africa", "custom_domain": true }
  ],
  // Storage for delivery reports and click counts (namespace "sendfair").
  "kv_namespaces": [{ "binding": "SENDFAIR_KV", "id": "4184f9d4de9440119baf9408cecc938a" }],
  // Quote Check uploads, in the private R2 bucket sendfair-quote-check.
  "r2_buckets": [{ "binding": "QUOTE_CHECK_FILES", "bucket_name": "sendfair-quote-check" }],
  // Outbound email for rate alerts (Cloudflare Email Service). The domain must be
  // onboarded for Email Sending (Compute > Email Service > Email Sending) before emails send.
  "send_email": [{ "name": "EMAIL" }],
  // AI helper (chat assistant) powered by Cloudflare Workers AI.
  "ai": { "binding": "AI" },
  // Rate alerts run after the morning (11:30) and evening (21:30) Nairobi rate checks.
  // The 03:00 run also deletes Quote Check uploads, extracted data and reports after the retention period.
  // Every 20 minutes 17:00–21:59 UTC: post the day's Reel to TikTok / YouTube Shorts once it exists (/admin/social).
  "triggers": { "crons": ["30 8 * * *", "30 18 * * *", "0 3 * * *", "*/20 17-21 * * *"] },
  "observability": { "enabled": true },
  // Keep settings added in the Cloudflare dashboard (such as ADMIN_PASSWORD) when a new version deploys.
  "keep_vars": true
}
