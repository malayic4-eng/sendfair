// Cloudflare Workers settings for SendFair. Cloudflare reads this on every deploy.
{
  "name": "sendfair",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  // Builds the 30 pages into dist/ before each deploy.
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker for admin, API, redirect and logo routes (the www redirect is a Cloudflare rule).
    "run_worker_first": ["/admin*", "/api/*", "/go/*", "/logos/*"]
  },
  // The site's own address. www is forwarded to the main address.
  "routes": [
    { "pattern": "sendfair.africa", "custom_domain": true },
    { "pattern": "www.sendfair.africa", "custom_domain": true }
  ],
  // Storage for delivery reports and click counts (namespace "sendfair").
  "kv_namespaces": [{ "binding": "SENDFAIR_KV", "id": "4184f9d4de9440119baf9408cecc938a" }],
  // Outbound email for rate alerts (Cloudflare Email Service). The domain must be
  // onboarded for Email Sending (Compute > Email Service > Email Sending) before emails send.
  "send_email": [{ "name": "EMAIL" }],
  // AI helper (chat assistant) powered by Cloudflare Workers AI.
  "ai": { "binding": "AI" },
  // Rate alerts run after the morning (11:30) and evening (21:30) Nairobi rate checks.
  "triggers": { "crons": ["30 8 * * *", "30 18 * * *"] },
  "observability": { "enabled": true },
  // Keep settings added in the Cloudflare dashboard (such as ADMIN_PASSWORD) when a new version deploys.
  "keep_vars": true
}
